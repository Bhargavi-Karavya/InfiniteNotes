# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/infinitenotes

# Canonical public site origin (no trailing slash).
# Production: https://infinitenotes.tech
# Local development may use http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://infinitenotes.tech

# Optional local/dev app URL (fallback when SITE_URL is unset)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated hosts allowed for the Structured Catalog JSON importer.
# Example: catalogs.example.com,cdn.example.org
# Localhost is allowed automatically outside production.
IMPORT_CATALOG_ALLOWED_HOSTS=

# Required for signing session cookies (use a long random string in production)
AUTH_SECRET=change-me-to-a-long-random-string

# Development seed admin (used only by `npm run db:seed`)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
